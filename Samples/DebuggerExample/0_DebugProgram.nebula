// Declare namespace for this script
namespace "DebuggerExample_0";
import "DebugShared";

// Import of a function defined by the virtual machine
native void WriteLine(string message);

DebugShared::DBG_DUNBLE MY_GLOBAL_BUNDLE = {
    value = 10,
};

// Declare function with autoexec attribute to start as soon as script is loaded
func void main() autoexec
{
    bool flag = true;
    int[][] array = [];
    array.Append([]);
    array.Append([]);

    DebugShared::DBG_DUNBLE[][] objArrayArray = [];
    objArrayArray.Append([]);
    objArrayArray.Append([]);

    DebugShared::DBG_DUNBLE b = {
        value = DebugShared::MY_GLOBAL,
        child = {
            test2 = "HELLO WORLD",
        }
    };


    DebugShared::DBG_DUNBLE[] objArray = [];
    objArray.Append(b);
     DebugShared::DBG_DUNBLE[] objArray2 = objArrayArray[0];
    // THIS COPIES ARRAY ??
    objArray2.Append(b);
    // DOESNT COMPILE
    //objArrayArray[0].Append(b);
    // COMPILER DOESNT ERROR
    objArrayArray[0] = b;

    string test = "AAAAA";
    WriteLine(test);

    
    async InfiniteAdd(b);
    SayHi();
    b waittill "DONE";
    WriteLine(b.child.test2);
}

func void SayHi()
{
    WriteLine("Hi");
}

func void InfiniteAdd(DebugShared::DBG_DUNBLE obj)
{
    int i = 1;
    while(i > 0)
    {
        WriteLine("Square is: " + string(obj.value * obj.value));
        wait 0.5f;
        i -= 1;
    }

    obj notify "DONE";
}